\nomenclatureentry{M$\mathcal{N}$@[{$\mathcal{N}$}]\begingroup Total kg-moles per unit mass.\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{M$\mathcal{N}_j$@[{$\mathcal{N}_j$}]\begingroup Number of kg-moles per unit mass of species $j$.\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{M$\mathcal{L}$@[{$\mathcal{L}$}]\begingroup The Lagrangian\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{M$\mathcal{M}_j$@[{$\mathcal{M}_j$}]\begingroup Molecular weight of species $j$ in kg / kg-mole\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$a_{ij}$@[{$a_{ij}$}]\begingroup Stoichiometric coefficients, e.g. number of atoms of element $i$ in species $j$. Weighted by element $i$'s molecular weight\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$\hat{R}$@[{$\hat{R}$}]\begingroup Universal gas constant ($\approx$ 8314 kJ/kg-K)\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$b_i$@[{$b_i$}]\begingroup Sum of contributions from each species towards constraint for element $i$, i.e. $\sum_{j=1}^\text{NS} a_{i,j}\mathcal{N}_j$\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$p_\text{ref}$@[{$p_\text{ref}$}]\begingroup Reference pressure (typically 1 atm or 1 bar).\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$G$@[{$G$}]\begingroup Gibbs free-energy\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$F$@[{$F$}]\begingroup Helmholtz free-energy\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$T$@[{$T$}]\begingroup Temperature (K)\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$q_j$@[{$q_j$}]\begingroup Charge of species $j$ (0 for neutrals, 1 for ions, -1 for electrons)\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$V$@[{$V$}]\begingroup Specific volume ($m^3/$kg)\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$\rho$@[{$\rho$}]\begingroup Density ($kg/m^3)$\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$b_i^\circ$@[{$b_i^\circ$}]\begingroup Specified mass fraction of element $i$\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$U_j^\circ$@[{$U_j^\circ$}]\begingroup Standard state internal energy of species $j$ (J/kg)\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$H_j^\circ$@[{$H_j^\circ$}]\begingroup Standard state enthalpy of species $j$ (J/kg)\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$c_{v,j}^\circ$@[{$c_{v,j}^\circ$}]\begingroup Standard state specific heat of species $j$\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$c_{p,j}^\circ$@[{$c_{p,j}^\circ$}]\begingroup Standard state specific heat of species $j$\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$u_0'$@[{$u_0'$}]\begingroup User-specified internal energy (J/kg)\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$h_0'$@[{$h_0'$}]\begingroup User-specified enthalpy (J/kg)\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$u'$@[{$u'$}]\begingroup Sum of contributions from each species towards internal energy constraint, i.e. $\sum_{j}^\text{NS} \mathcal{N}_j U_j^\circ$\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{R$h'$@[{$h'$}]\begingroup Sum of contributions from each species towards enthalpy  constraint, i.e. $\sum_{j}^\text{NS} \mathcal{N}_j H_j^\circ$\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{G$\lambda$@[{$\lambda$}]\begingroup Lagrange multiplier\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{G$\mu_j$@[{$\mu_j$}]\begingroup Chemical potential of species $j$\nomeqref {0.0}|nompageref}{4}
\nomenclatureentry{G$\mu_j^\circ$@[{$\mu_j^\circ$}]\begingroup Standard-state chemical potential of species $j$\nomeqref {0.0}|nompageref}{4}
