% ── Spacing ───────────────────────────────────────────────────────────────────
\setstretch{1.1}
\setlength{\abovedisplayskip}{8pt}
\setlength{\belowdisplayskip}{8pt}

\definecolor{defblue}{HTML}{029ba3}
\definecolor{defred}{HTML}{8f0342}
\definecolor{deforange}{HTML}{ba6006}
\definecolor{defgreen}{HTML}{017301}

% ── Section heading styles ────────────────────────────────────────────────────
\titleformat{\section}
  {\color{defblue}\normalfont\Large\bfseries}
  {\thesection}{1em}{}
  [\color{defblue!40}\titlerule]
\titleformat{\subsection}
  {\color{deforange}\normalfont\large\bfseries}
  {\thesubsection}{1em}{}
  [\color{deforange!40}\titlerule]
\titleformat{\subsubsection}
  {\color{defred}\normalfont\large\bfseries}
  {\thesubsubsection}{1em}{}
  [\color{defred!40}\titlerule]


% ── Custom commands ───────────────────────────────────────────────────────────
\newcommand{\pd}[2]{\frac{\partial #1}{\partial #2}}
\newcommand{\ub}[2]{\underbracket{#1}_{#2}}
\newcommand{\ob}[2]{\overbracket{#1}^{#2}}
\newcommand{\bb}[1]{\left[ #1 \right]}
\newcommand{\bp}[1]{\left( #1 \right)}
\newcommand{\bcb}[1]{\left\{ #1 \right\}}

% ── Nomenclature ──────────────────────────────────────────────────────────────
\usepackage[intoc]{nomencl}
\makenomenclature
\renewcommand{\nomgroup}[1]{%
  \item[\bfseries
  \ifstrequal{#1}{G}{Greek Symbols}{%
  \ifstrequal{#1}{R}{Roman Symbols}{%
  \ifstrequal{#1}{M}{Calligraphic Symbols}{%
  \ifstrequal{#1}{S}{Subscripts}{}}}}%  % 4 closing }
]}

% ── Equation numbering ────────────────────────────────────────────────────────
\numberwithin{equation}{section}

% ── Definition environment (boxed with left bar) ──────────────────────────────
\newtheoremstyle{defwithitnote}
  {3pt}{3pt}
  {\normalfont}
  {}
  {\bfseries}
  {:}
  {0.5em}
  {\thmname{#1}\thmnumber{ #2}\thmnote{ \textit{(#3)}}}
\theoremstyle{defwithitnote}
\newtheorem{definitioninner}{Definition}[section]

\newenvironment{definition}[1][]{%
  \begin{mdframed}[
    linecolor=defblue,
    backgroundcolor=white,
    linewidth=1.5pt,
    topline=false,
    rightline=false,
    bottomline=false,
    nobreak=false,
    leftline=true,
    innerleftmargin=8pt,
    innerrightmargin=8pt,
    innertopmargin=4pt,
    innerbottommargin=4pt
  ]%
  \begin{definitioninner}[#1]%
}{%
  \end{definitioninner}%
  \end{mdframed}%
}


% ── Remark environment (numbered) ────────────────────────────────────────────
\definecolor{remarkpurple}{RGB}{88,50,168}
\definecolor{remarkbg}{RGB}{248,248,248}

\newtheoremstyle{remarkstyle}
  {3pt}{3pt}
  {\normalfont}
  {}
  {\bfseries\color{remarkpurple}}
  {:}
  {0.5em}
  {\thmname{#1}\thmnumber{ #2}\thmnote{ \textit{(#3)}}}

\theoremstyle{remarkstyle}
\newtheorem{remarkinner}{Remark}[section]

\newenvironment{remark}[1][]{%
  \begin{mdframed}[
    linecolor=remarkpurple,
    backgroundcolor=remarkbg,
    linewidth=1pt,
    topline=false,
    rightline=false,
    bottomline=false,
    leftline=true,
    nobreak=false,
    innerleftmargin=8pt,
    innerrightmargin=8pt,
    innertopmargin=4pt,
    innerbottommargin=4pt
  ]%
  \begin{remarkinner}[#1]%
}{%
  \end{remarkinner}%
  \end{mdframed}%
}

