\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=blue!60!black,
  citecolor=green!50!black,
  urlcolor=cyan!60!black,
  bookmarksnumbered=true,
  bookmarksopen=true
}

% \defsym{command name}{label}{symbol}
\newcommand{\defsym}[3]{%
  \expandafter\newcommand\csname #1\endcsname{\hyperref[#2]{#3}}%
}


